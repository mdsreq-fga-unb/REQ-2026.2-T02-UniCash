EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Emulator Suite (RNF30). Em aparelho físico no Expo Go, use o IP da sua máquina na rede.
EXPO_PUBLIC_USE_EMULATOR=true
EXPO_PUBLIC_EMULATOR_HOST=localhost

# Opcional: URL de retorno das ligações de e-mail (confirmação e redefinição de senha).
# Use uma URL https de um domínio autorizado em Authentication > Settings > Authorized domains
# (por padrão: <id-do-projeto>.firebaseapp.com). Se for outro domínio, adicione-o à lista antes.
# Deixe vazio no Emulator Suite: ele não envia e-mails reais.
EXPO_PUBLIC_AUTH_CONTINUE_URL=
