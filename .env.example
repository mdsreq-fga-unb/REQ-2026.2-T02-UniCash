# Copie para .env e ajuste. IP da sua máquina na rede Wi-Fi (Linux: hostname -I).
EXPO_HOST_IP=192.168.0.10

# Token pessoal do Expo (expo.dev > Account settings > Access tokens).
# Sem ele, o Expo tenta abrir o navegador para login dentro do container e falha.
EXPO_TOKEN=

#Os tokens estão no firebase
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=