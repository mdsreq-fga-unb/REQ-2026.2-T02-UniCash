
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function dono(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function dataValida(data) {
      return data is string
        && data.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function descricaoValida(d) {
      return !('descricao' in d)
        || d.descricao == null
        || (d.descricao is string && d.descricao.size() <= 255);
    }

    function valorValido(d) {
      return d.valor_centavos is int
        && d.valor_centavos > 0
        && d.valor_centavos <= 99999999999;
    }

    function receitaValida(d) {
      return d.keys().hasOnly([
          'valor_centavos', 'data', 'titulo', 'descricao',
          'recorrencia_id', 'criado_em', 'atualizado_em'
        ])
        && d.keys().hasAll([
          'valor_centavos', 'data', 'titulo',
          'criado_em', 'atualizado_em'
        ])
        && valorValido(d)
        && dataValida(d.data)
        && d.titulo is string
        && d.titulo.size() >= 1
        && d.titulo.size() <= 80
        && descricaoValida(d)
        && (!('recorrencia_id' in d)
          || d.recorrencia_id == null
          || d.recorrencia_id is string);
    }

    function despesaValida(d) {
      return d.keys().hasOnly([
          'valor_centavos', 'data', 'titulo', 'descricao',
          'categoria_id', 'fixa_ou_variavel', 'essencial',
          'recorrencia_id', 'criado_em', 'atualizado_em'
        ])
        && d.keys().hasAll([
          'valor_centavos', 'data', 'titulo',
          'criado_em', 'atualizado_em'
        ])
        && valorValido(d)
        && dataValida(d.data)
        && d.titulo is string
        && d.titulo.size() >= 1
        && d.titulo.size() <= 80
        && descricaoValida(d)
        && (!('categoria_id' in d)
          || d.categoria_id == null
          || d.categoria_id is string)
        && (!('fixa_ou_variavel' in d)
          || d.fixa_ou_variavel == null
          || d.fixa_ou_variavel in ['fixa', 'variavel'])
        && (!('essencial' in d)
          || d.essencial == null
          || d.essencial in [0, 1])
        && (!('recorrencia_id' in d)
          || d.recorrencia_id == null
          || d.recorrencia_id is string);
    }

    function marcadorDespesaValido(d) {
      return d.keys().hasOnly(['excluido_em', 'atualizado_em'])
        && d.excluido_em is string && d.excluido_em.size() > 0
        && d.atualizado_em is string && d.atualizado_em.size() > 0;
    }

    function recorrenciaBaseValida(d) {
      return d.keys().hasOnly([
          'tipo', 'intervalo', 'unidade', 'inicio', 'termino',
          'ativa', 'valor_centavos', 'titulo', 'descricao',
          'categoria_id', 'fixa_ou_variavel', 'essencial',
          'atualizado_em', 'excluido_em'
        ])
        && d.keys().hasAll([
          'tipo', 'intervalo', 'unidade', 'inicio',
          'ativa', 'valor_centavos', 'titulo', 'atualizado_em'
        ])
        && d.tipo in ['receita', 'despesa']
        && d.intervalo is int
        && d.intervalo > 0
        && d.unidade in ['dia', 'mes', 'ano']
        && dataValida(d.inicio)
        && d.ativa is bool
        && valorValido(d)
        && d.titulo is string
        && d.titulo.size() >= 1
        && d.titulo.size() <= 80
        && descricaoValida(d)
        && (!('termino' in d)
          || (dataValida(d.termino) && d.termino >= d.inicio))
        && (!('categoria_id' in d)
          || d.categoria_id == null
          || d.categoria_id is string)
        && (!('fixa_ou_variavel' in d)
          || d.fixa_ou_variavel == null
          || d.fixa_ou_variavel in ['fixa', 'variavel'])
        && (!('essencial' in d)
          || d.essencial == null
          || d.essencial in [0, 1]);
    }

    function recorrenciaAtivaValida(d) {
      return recorrenciaBaseValida(d)
        && (!('excluido_em' in d) || d.excluido_em == null);
    }

    function recorrenciaTombstoneValida(d) {
      return recorrenciaBaseValida(d)
        && d.excluido_em is string
        && d.excluido_em.size() > 0
        && d.ativa == false;
    }

    // ---- UC10: perfil da conta (usuarios/{uid}) ----
    // A senha nunca chega ao Firestore (fica no Firebase Authentication, RNF01); a política de senha
    // vale no cliente e na configuração do Authentication. Aqui só se valida o e-mail.
    function emailValido(e) {
      return e is string
        && e.size() <= 254
        && e.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$');
    }

    function emailDoToken() {
      return request.auth.token.email != null ? request.auth.token.email.lower() : '';
    }

    function perfilValido(d) {
      return d.keys().hasOnly(['email', 'nome', 'criado_em', 'atualizado_em'])
        && d.keys().hasAll(['email', 'criado_em'])
        && emailValido(d.email)
        && d.email.lower() == emailDoToken()
        && (!('nome' in d) || (d.nome is string && d.nome.size() <= 80));
    }

    match /usuarios/{uid} {
      allow read: if dono(uid);
      allow create: if dono(uid)
        && perfilValido(request.resource.data)
        && request.resource.data.criado_em == request.time;
      allow update: if dono(uid)
        && perfilValido(request.resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['criado_em']);
      allow delete: if false;
    }

    match /usuarios/{uid}/receitas/{id} {
      allow read, delete: if dono(uid);
      allow create, update: if dono(uid)
        && receitaValida(request.resource.data);
    }

    match /usuarios/{uid}/despesas/{id} {
      allow read: if dono(uid);
      allow create: if dono(uid)
        && (despesaValida(request.resource.data) || marcadorDespesaValido(request.resource.data));
      allow update: if dono(uid)
        && !('excluido_em' in resource.data)
        && (despesaValida(request.resource.data) || marcadorDespesaValido(request.resource.data));
      allow delete: if false;
    }

    match /usuarios/{uid}/recorrencias/{id} {
      allow read: if dono(uid);
      allow create: if dono(uid)
        && (recorrenciaAtivaValida(request.resource.data) || recorrenciaTombstoneValida(request.resource.data));
      allow update: if dono(uid)
        && !('excluido_em' in resource.data)
        && (recorrenciaAtivaValida(request.resource.data) || recorrenciaTombstoneValida(request.resource.data));
      allow delete: if false;
    }
  }
}
