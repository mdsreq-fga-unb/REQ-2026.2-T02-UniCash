rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() { return request.auth != null; }
    function dono(uid) { return logado() && request.auth.uid == uid; }

    // Espelha a validação de e-mail do cliente (RNF04). A senha nunca chega ao Firestore:
    // a política de senha é validada no cliente e o Firebase Authentication guarda o hash (RNF01).
    function emailValido(e) {
      return e is string && e.size() <= 254 && e.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$');
    }
    function nomeValido(d) {
      return !('nome' in d) || (d.nome is string && d.nome.size() <= 80);
    }
    function emailDoToken() {
      return request.auth.token.email != null ? request.auth.token.email.lower() : '';
    }

    // Perfil: cada usuário lê e altera apenas o próprio (RNF02, RNF03). Sem CPF.
    match /users/{uid} {
      allow read: if dono(uid);

      allow create: if dono(uid)
        && request.resource.data.keys().hasOnly(['email', 'nome', 'criadoEm', 'atualizadoEm'])
        && request.resource.data.keys().hasAll(['email', 'criadoEm'])
        && emailValido(request.resource.data.email)
        && request.resource.data.email.lower() == emailDoToken()
        && request.resource.data.criadoEm == request.time
        && nomeValido(request.resource.data);

      allow update: if dono(uid)
        && request.resource.data.keys().hasOnly(['email', 'nome', 'criadoEm', 'atualizadoEm'])
        && request.resource.data.criadoEm == resource.data.criadoEm
        && emailValido(request.resource.data.email)
        && request.resource.data.email.lower() == emailDoToken()
        && nomeValido(request.resource.data);

      allow delete: if false;

      // Dados sincronizados (RF62): só o dono, e só com e-mail confirmado.
      match /{dados=**} {
        allow read, write: if dono(uid) && request.auth.token.email_verified == true;
      }
    }

    match /{outro=**} {
      allow read, write: if false;
    }
  }
}
