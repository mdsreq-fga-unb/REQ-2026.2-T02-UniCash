
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function dono(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    /** UC10: dados financeiros só são liberados com e-mail confirmado. */
    function donoConfirmado(uid) {
      return dono(uid) && request.auth.token.email_verified == true;
    }

    function semPedidoDeRemocao(uid) {
      return !exists(/databases/$(database)/documents/pedidos_remocao/$(uid));
    }

    function caminhoComprovante(id) {
      return /databases/$(database)/documents/comprovantes_remocao/$(id);
    }

    match /comprovantes_remocao/{id} {
      // A consulta exige o UUID exato. O documento contém apenas a confirmação.
      allow get: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['recebido'])
        && request.resource.data.recebido == true
        && !exists(/databases/$(database)/documents/pedidos_remocao/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/pedidos_remocao/$(request.auth.uid)).data.comprovante_id == id;
    }

    match /pedidos_remocao/{uid} {
      allow get: if donoConfirmado(uid);
      allow create: if donoConfirmado(uid)
        && request.auth.token.auth_time * 1000 >= request.time.toMillis() - 300000
        && request.resource.data.keys().hasOnly(['status', 'solicitado_em', 'comprovante_id'])
        && request.resource.data.comprovante_id is string
        && request.resource.data.comprovante_id.matches('^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$')
        && !exists(caminhoComprovante(request.resource.data.comprovante_id))
        && getAfter(caminhoComprovante(request.resource.data.comprovante_id)).data.recebido == true
        && request.resource.data.status == 'pendente'
        && request.resource.data.solicitado_em == request.time;
    }

    function dataValida(data) {
      return data is string
        && data.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function descricaoValida(d) {
      return !('descricao' in d)
        || d.descricao == null
        || (d.descricao is string && d.descricao.size() <= 255);
    }

    function valorValido(d) {
      return d.valor_centavos is int
        && d.valor_centavos > 0
        && d.valor_centavos <= 99999999999;
    }

    function receitaValida(d) {
      return d.keys().hasOnly([
          'valor_centavos', 'data', 'titulo', 'descricao',
          'recorrencia_id', 'criado_em', 'atualizado_em'
        ])
        && d.keys().hasAll([
          'valor_centavos', 'data', 'titulo',
          'criado_em', 'atualizado_em'
        ])
        && valorValido(d)
        && dataValida(d.data)
        && d.titulo is string
        && d.titulo.size() >= 1
        && d.titulo.size() <= 80
        && descricaoValida(d)
        && (!('recorrencia_id' in d)
          || d.recorrencia_id == null
          || d.recorrencia_id is string);
    }

    function despesaValida(d) {
      return d.keys().hasOnly([
          'valor_centavos', 'data', 'titulo', 'descricao',
          'categoria_id', 'fixa_ou_variavel', 'essencial',
          'recorrencia_id', 'criado_em', 'atualizado_em'
        ])
        && d.keys().hasAll([
          'valor_centavos', 'data', 'titulo',
          'criado_em', 'atualizado_em'
        ])
        && valorValido(d)
        && dataValida(d.data)
        && d.titulo is string
        && d.titulo.size() >= 1
        && d.titulo.size() <= 80
        && descricaoValida(d)
        && (!('categoria_id' in d)
          || d.categoria_id == null
          || d.categoria_id is string)
        && (!('fixa_ou_variavel' in d)
          || d.fixa_ou_variavel == null
          || d.fixa_ou_variavel in ['fixa', 'variavel'])
        && (!('essencial' in d)
          || d.essencial == null
          || d.essencial in [0, 1])
        && (!('recorrencia_id' in d)
          || d.recorrencia_id == null
          || d.recorrencia_id is string);
    }

    function marcadorLancamentoValido(d) {
      return d.keys().hasOnly(['excluido_em', 'atualizado_em'])
        && d.excluido_em is string && d.excluido_em.size() > 0
        && d.atualizado_em is string && d.atualizado_em.size() > 0;
    }

    function recorrenciaBaseValida(d) {
      return d.keys().hasOnly([
          'tipo', 'intervalo', 'unidade', 'inicio', 'termino',
          'ativa', 'valor_centavos', 'titulo', 'descricao',
          'categoria_id', 'fixa_ou_variavel', 'essencial',
          'atualizado_em', 'excluido_em'
        ])
        && d.keys().hasAll([
          'tipo', 'intervalo', 'unidade', 'inicio',
          'ativa', 'valor_centavos', 'titulo', 'atualizado_em'
        ])
        && d.tipo in ['receita', 'despesa']
        && d.intervalo is int
        && d.intervalo > 0
        && d.unidade in ['dia', 'mes', 'ano']
        && dataValida(d.inicio)
        && d.ativa is bool
        && valorValido(d)
        && d.titulo is string
        && d.titulo.size() >= 1
        && d.titulo.size() <= 80
        && descricaoValida(d)
        && (!('termino' in d)
          || (dataValida(d.termino) && d.termino >= d.inicio))
        && (!('categoria_id' in d)
          || d.categoria_id == null
          || d.categoria_id is string)
        && (!('fixa_ou_variavel' in d)
          || d.fixa_ou_variavel == null
          || d.fixa_ou_variavel in ['fixa', 'variavel'])
        && (!('essencial' in d)
          || d.essencial == null
          || d.essencial in [0, 1]);
    }

    function recorrenciaAtivaValida(d) {
      return recorrenciaBaseValida(d)
        && (!('excluido_em' in d) || d.excluido_em == null);
    }

    function recorrenciaTombstoneValida(d) {
      return recorrenciaBaseValida(d)
        && d.excluido_em is string
        && d.excluido_em.size() > 0
        && d.ativa == false;
    }

    // ---- UC10: perfil da conta (usuarios/{uid}) ----
    // A senha nunca chega ao Firestore (fica no Firebase Authentication, RNF01); a política de senha
    // vale no cliente e na configuração do Authentication. Aqui só se valida o e-mail.
    function emailValido(e) {
      return e is string
        && e.size() <= 254
        && e.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$');
    }

    function emailDoToken() {
      return request.auth.token.email != null ? request.auth.token.email.lower() : '';
    }

    function perfilValido(d) {
      return d.keys().hasOnly(['email', 'nome', 'criado_em', 'atualizado_em'])
        && d.keys().hasAll(['email', 'criado_em'])
        && emailValido(d.email)
        && d.email.lower() == emailDoToken()
        && (!('nome' in d) || (d.nome is string && d.nome.size() <= 80));
    }

    match /usuarios/{uid} {
      allow read: if dono(uid);
      allow create: if dono(uid) && semPedidoDeRemocao(uid)
        && perfilValido(request.resource.data)
        && request.resource.data.criado_em == request.time;
      allow update: if dono(uid) && semPedidoDeRemocao(uid)
        && perfilValido(request.resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['criado_em']);
      allow delete: if dono(uid) && semPedidoDeRemocao(uid) && request.auth.token.email_verified == false;
    }

    function chavePadraoValida(chave) {
      return chave in [
        'casa', 'alimentacao', 'mobilidade', 'estudos',
        'saude', 'lazer', 'reserva_financeira'
      ];
    }

    function nomePadrao(chave) {
      return chave == 'casa' ? 'Casa'
        : chave == 'alimentacao' ? 'Alimentação'
        : chave == 'mobilidade' ? 'Mobilidade'
        : chave == 'estudos' ? 'Estudos'
        : chave == 'saude' ? 'Saúde'
        : chave == 'lazer' ? 'Lazer'
        : chave == 'reserva_financeira' ? 'Reserva financeira'
        : '';
    }

    function nomeNormalizadoPadrao(chave) {
      return chave == 'casa' ? 'casa'
        : chave == 'alimentacao' ? 'alimentação'
        : chave == 'mobilidade' ? 'mobilidade'
        : chave == 'estudos' ? 'estudos'
        : chave == 'saude' ? 'saúde'
        : chave == 'lazer' ? 'lazer'
        : chave == 'reserva_financeira' ? 'reserva financeira'
        : '';
    }

    function limiteCategoriaValido(d) {
      return (d.limite_tipo == null
          && d.limite_centavos == null
          && d.limite_percentual_centesimos == null)
        || (d.limite_tipo == 'valor'
          && d.limite_centavos is int
          && d.limite_centavos > 0
          && d.limite_centavos <= 99999999999
          && d.limite_percentual_centesimos == null)
        || (d.limite_tipo == 'percentual_renda'
          && d.limite_centavos == null
          && d.limite_percentual_centesimos is int
          && d.limite_percentual_centesimos >= 100
          && d.limite_percentual_centesimos <= 10000);
    }

    function categoriaBaseValida(d) {
      return d.keys().hasOnly([
          'padrao', 'chave', 'nome', 'nome_normalizado',
          'limite_tipo', 'limite_centavos', 'limite_percentual_centesimos',
          'excluido_em', 'criado_em', 'atualizado_em', 'aliases'
        ])
        && d.keys().hasAll([
          'padrao', 'chave', 'nome', 'nome_normalizado',
          'limite_tipo', 'limite_centavos', 'limite_percentual_centesimos',
          'excluido_em', 'criado_em', 'atualizado_em', 'aliases'
        ])
        && d.padrao is bool
        && (d.chave == null || d.chave is string)
        && d.nome is string
        && d.nome.size() >= 1
        && d.nome.size() <= 30
        && d.nome_normalizado is string
        && d.nome_normalizado.size() >= 1
        && d.nome_normalizado.size() <= 30
        && limiteCategoriaValido(d)
        && (d.excluido_em == null
          || (d.excluido_em is string && d.excluido_em.size() > 0))
        && d.criado_em is string && d.criado_em.size() > 0
        && d.atualizado_em is string && d.atualizado_em.size() > 0
        && d.aliases is list
        && d.aliases.size() <= 64;
    }

    function categoriaAtivaValida(d) {
      return categoriaBaseValida(d) && d.excluido_em == null;
    }

    function categoriaPropriaAtivaValida(d, id) {
      return categoriaAtivaValida(d)
        && d.padrao == false
        && d.chave == null
        && d.aliases.size() == 0
        && !id.matches('^padrao_.*');
    }

    function categoriaPropriaTombstoneValida(d, id) {
      return categoriaBaseValida(d)
        && d.padrao == false
        && d.chave == null
        && d.aliases.size() == 0
        && !id.matches('^padrao_.*')
        && d.excluido_em is string
        && d.excluido_em.size() > 0
        && d.limite_tipo == null
        && d.limite_centavos == null
        && d.limite_percentual_centesimos == null;
    }

    /**
     * Normalização one-way de tombstone legado: permite apenas limpar os
     * campos de limite. Identidade, aliases, excluido_em e timestamps devem
     * permanecer exatamente iguais, impedindo ressurreição ou reescrita.
     */
    function categoriaPropriaTombstoneNormalizavel(novo, atual, id) {
      return categoriaBaseValida(novo)
        && novo.padrao == false
        && novo.chave == null
        && novo.aliases.size() == 0
        && !id.matches('^padrao_.*')
        && atual.excluido_em is string
        && atual.excluido_em.size() > 0
        && novo.excluido_em == atual.excluido_em
        && novo.nome == atual.nome
        && novo.nome_normalizado == atual.nome_normalizado
        && novo.criado_em == atual.criado_em
        && novo.atualizado_em == atual.atualizado_em
        && novo.limite_tipo == null
        && novo.limite_centavos == null
        && novo.limite_percentual_centesimos == null;
    }

    function categoriaPadraoValida(d, id) {
      return categoriaAtivaValida(d)
        && d.padrao == true
        && chavePadraoValida(d.chave)
        && id == 'padrao_' + d.chave
        && d.nome == nomePadrao(d.chave)
        && d.nome_normalizado == nomeNormalizadoPadrao(d.chave);
    }

    match /usuarios/{uid}/categorias/{categoriaId} {
      allow read: if donoConfirmado(uid);
      allow create: if donoConfirmado(uid) && semPedidoDeRemocao(uid)
        && (
          categoriaPadraoValida(request.resource.data, categoriaId)
          || categoriaPropriaAtivaValida(request.resource.data, categoriaId)
          || categoriaPropriaTombstoneValida(request.resource.data, categoriaId)
        );
      allow update: if donoConfirmado(uid) && semPedidoDeRemocao(uid)
        && resource.data.excluido_em == null
        && (
          (
            resource.data.padrao == true
            && categoriaPadraoValida(request.resource.data, categoriaId)
            && request.resource.data.nome == resource.data.nome
            && request.resource.data.nome_normalizado == resource.data.nome_normalizado
            && request.resource.data.chave == resource.data.chave
            && request.resource.data.padrao == true
            && request.resource.data.criado_em == resource.data.criado_em
            && request.resource.data.aliases.toSet().hasAll(resource.data.aliases.toSet())
          )
          || (
            resource.data.padrao == false
            && (
              categoriaPropriaAtivaValida(request.resource.data, categoriaId)
              || categoriaPropriaTombstoneValida(request.resource.data, categoriaId)
            )
            && request.resource.data.padrao == false
            && request.resource.data.chave == null
            && request.resource.data.aliases.size() == 0
            && request.resource.data.criado_em == resource.data.criado_em
          )
        );
      // Exceção restrita para normalizar tombstone legado (issue #71).
      allow update: if donoConfirmado(uid) && semPedidoDeRemocao(uid)
        && categoriaPropriaTombstoneNormalizavel(
          request.resource.data,
          resource.data,
          categoriaId
        );
      allow delete: if false;
    }

    function metaCoerente(d) {
      return (d.tipo == 'gasto'
          && (!('valor_acumulado_centavos' in d) || d.valor_acumulado_centavos == null)
          && (!('valor_acumulado_atualizado_em' in d) || d.valor_acumulado_atualizado_em == null))
        || (d.tipo == 'investimento'
          && (!('categoria_id' in d) || d.categoria_id == null)
          && (
            ((!('valor_acumulado_centavos' in d) || d.valor_acumulado_centavos == null)
              && (!('valor_acumulado_atualizado_em' in d)
                || d.valor_acumulado_atualizado_em == null))
            || (('valor_acumulado_centavos' in d) && d.valor_acumulado_centavos != null
              && ('valor_acumulado_atualizado_em' in d)
              && d.valor_acumulado_atualizado_em != null)
          ));
    }

    function camposRevisaoValido(m) {
      return m is map
        && m.keys().hasOnly([
          'objetivo', 'valor_alvo_centavos', 'prazo', 'inicio',
          'categoria_id', 'valor_acumulado'
        ])
        && (!('objetivo' in m) || (m.objetivo is int && m.objetivo >= 0))
        && (!('valor_alvo_centavos' in m)
          || (m.valor_alvo_centavos is int && m.valor_alvo_centavos >= 0))
        && (!('prazo' in m) || (m.prazo is int && m.prazo >= 0))
        && (!('inicio' in m) || (m.inicio is int && m.inicio >= 0))
        && (!('categoria_id' in m) || (m.categoria_id is int && m.categoria_id >= 0))
        && (!('valor_acumulado' in m)
          || (m.valor_acumulado is int && m.valor_acumulado >= 0));
    }

    function metaValida(d) {
      return d.keys().hasOnly([
          'objetivo', 'tipo', 'valor_alvo_centavos', 'prazo',
          'inicio', 'categoria_id', 'valor_acumulado_centavos',
          'valor_acumulado_atualizado_em', 'revisao', 'campos_revisao',
          'criado_em', 'atualizado_em', 'excluido_em'
        ])
        && d.keys().hasAll([
          'objetivo', 'tipo', 'valor_alvo_centavos', 'prazo',
          'criado_em', 'atualizado_em'
        ])
        && d.objetivo is string
        && d.objetivo.size() >= 1
        && d.objetivo.size() <= 80
        && d.tipo in ['gasto', 'investimento']
        && d.valor_alvo_centavos is int
        && d.valor_alvo_centavos > 0
        && d.valor_alvo_centavos <= 99999999999
        && dataValida(d.prazo)
        && (!('inicio' in d)
          || d.inicio == null
          || (dataValida(d.inicio) && d.inicio <= d.prazo))
        && (!('categoria_id' in d)
          || d.categoria_id == null
          || (d.categoria_id is string && d.categoria_id.size() > 0))
        && (!('valor_acumulado_centavos' in d)
          || d.valor_acumulado_centavos == null
          || (d.valor_acumulado_centavos is int
            && d.valor_acumulado_centavos >= 0
            && d.valor_acumulado_centavos <= 99999999999))
        && (!('valor_acumulado_atualizado_em' in d)
          || d.valor_acumulado_atualizado_em == null
          || (d.valor_acumulado_atualizado_em is string
            && d.valor_acumulado_atualizado_em.size() > 0))
        && metaCoerente(d)
        && (!('revisao' in d) || (d.revisao is int && d.revisao >= 0))
        && (!('campos_revisao' in d)
          || d.campos_revisao == null
          || camposRevisaoValido(d.campos_revisao))
        && d.criado_em is string && d.criado_em.size() > 0
        && d.atualizado_em is string && d.atualizado_em.size() > 0
        && (!('excluido_em' in d)
          || d.excluido_em == null
          || (d.excluido_em is string && d.excluido_em.size() > 0));
    }

    function metaAtivaValida(d) {
      return metaValida(d)
        && (!('excluido_em' in d) || d.excluido_em == null);
    }

    function metaTombstoneValida(d) {
      return metaValida(d)
        && d.excluido_em is string
        && d.excluido_em.size() > 0;
    }

    match /usuarios/{uid}/metas/{metaId} {
      allow read: if donoConfirmado(uid);
      allow create: if donoConfirmado(uid) && semPedidoDeRemocao(uid)
        && (metaAtivaValida(request.resource.data) || metaTombstoneValida(request.resource.data));
      allow update: if donoConfirmado(uid) && semPedidoDeRemocao(uid)
        && (!('excluido_em' in resource.data) || resource.data.excluido_em == null)
        && request.resource.data.criado_em == resource.data.criado_em
        && (metaAtivaValida(request.resource.data) || metaTombstoneValida(request.resource.data));
      allow delete: if false;
    }

    match /usuarios/{uid}/alertas/{id} {
      allow read: if donoConfirmado(uid);
      allow create: if donoConfirmado(uid) && semPedidoDeRemocao(uid) && alertaValido(request.resource.data)
        && getAfter(categoriaDoAlerta(request.resource.data.ref_id)).data.excluido_em == null;
      allow update: if false;
      allow delete: if donoConfirmado(uid) && semPedidoDeRemocao(uid)
        && getAfter(categoriaDoAlerta(resource.data.ref_id)).data.excluido_em is string;

      function categoriaDoAlerta(refId) {
        return /databases/$(database)/documents/usuarios/$(uid)/categorias/$(refId);
      }

      function alertaValido(d) {
        return d.keys().hasAll([
          'tipo', 'ref_id', 'periodo', 'categoria_nome',
          'gasto_centavos', 'limite_centavos', 'emitido_em'
        ]) && d.keys().hasOnly([
          'tipo', 'ref_id', 'periodo', 'categoria_nome',
          'gasto_centavos', 'limite_centavos', 'emitido_em'
        ])
        && d.tipo in ['aproximacao', 'ultrapassagem']
        && d.ref_id is string && d.ref_id.matches('^[a-zA-Z0-9_-]{1,100}$')
        && d.periodo is string && d.periodo.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
        && id == d.tipo + '_' + d.ref_id + '_' + d.periodo
        && d.categoria_nome is string && d.categoria_nome.size() >= 1 && d.categoria_nome.size() <= 30
        && d.gasto_centavos is int && d.gasto_centavos > 0 && d.gasto_centavos <= 9007199254740991
        && d.limite_centavos is int && d.limite_centavos > 0 && d.limite_centavos <= 9007199254740991
        && d.emitido_em is string
        && d.emitido_em.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{3}Z$');
      }
    }

    match /usuarios/{uid}/saldo_inicial/{id} {
      allow get: if donoConfirmado(uid) && id == 'atual';
      allow create, update: if donoConfirmado(uid) && semPedidoDeRemocao(uid) && id == 'atual'
        && request.resource.data.keys().hasOnly(['valor_centavos', 'mes_referencia'])
        && request.resource.data.valor_centavos is int
        && request.resource.data.valor_centavos >= -9007199254740991
        && request.resource.data.valor_centavos <= 9007199254740991
        && request.resource.data.mes_referencia is string
        && request.resource.data.mes_referencia.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
        && !request.resource.data.mes_referencia.matches('^0000-.*$');
    }

    match /usuarios/{uid}/receitas/{id} {
      allow read: if donoConfirmado(uid);
      allow create: if donoConfirmado(uid) && semPedidoDeRemocao(uid)
        && (receitaValida(request.resource.data) || marcadorLancamentoValido(request.resource.data));
      allow update: if donoConfirmado(uid) && semPedidoDeRemocao(uid)
        && !('excluido_em' in resource.data)
        && (receitaValida(request.resource.data) || marcadorLancamentoValido(request.resource.data));
      allow delete: if false;
    }

    match /usuarios/{uid}/despesas/{id} {
      allow read: if donoConfirmado(uid);
      allow create: if donoConfirmado(uid) && semPedidoDeRemocao(uid)
        && (despesaValida(request.resource.data) || marcadorLancamentoValido(request.resource.data));
      allow update: if donoConfirmado(uid) && semPedidoDeRemocao(uid)
        && !('excluido_em' in resource.data)
        && (despesaValida(request.resource.data) || marcadorLancamentoValido(request.resource.data));
      allow delete: if false;
    }

    match /usuarios/{uid}/conquistas_historico/{id} {
      allow read: if donoConfirmado(uid);
      allow create: if donoConfirmado(uid) && semPedidoDeRemocao(uid) && desbloqueioValido(request.resource.data)
        && request.resource.data.keys().hasAll(['origem']);
      allow update: if donoConfirmado(uid) && semPedidoDeRemocao(uid) && desbloqueioValido(request.resource.data)
        && request.resource.data.get('origem', null) == resource.data.get('origem', null)
        && (resource.data.data == null
          || (request.resource.data.data is string && request.resource.data.data <= resource.data.data));
      allow delete: if false;

      function desbloqueioValido(d) {
        return id.matches('^(primeira-meta|no-verde:[0-9]{4}-(0[1-9]|1[0-2]))$')
          && d.keys().hasAll(['data']) && d.keys().hasOnly(['data', 'origem'])
          && (!('origem' in d) || (d.origem is string
            && d.origem.matches('^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$')))
          && (d.data == null || (d.data is string
            && d.data.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')));
      }
    }

    match /usuarios/{uid}/alertas_emitidos/{id} {
      allow read: if donoConfirmado(uid);
      allow create: if donoConfirmado(uid) && semPedidoDeRemocao(uid)
        && id.matches('^[0-9a-f]{32}$')
        && request.resource.data.keys().hasOnly(['mes', 'anterior_centavos', 'saldo_centavos', 'criado_em'])
        && request.resource.data.mes is string
        && request.resource.data.mes.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
        && request.resource.data.anterior_centavos is int
        && request.resource.data.anterior_centavos >= 0
        && request.resource.data.saldo_centavos is int
        && request.resource.data.saldo_centavos < 0
        && request.resource.data.criado_em is string;
      allow update: if donoConfirmado(uid) && semPedidoDeRemocao(uid) && request.resource.data == resource.data;
    }

    match /usuarios/{uid}/recorrencias/{id} {
      allow read: if donoConfirmado(uid);
      allow create: if donoConfirmado(uid) && semPedidoDeRemocao(uid)
        && (recorrenciaAtivaValida(request.resource.data) || recorrenciaTombstoneValida(request.resource.data));
      allow update: if donoConfirmado(uid) && semPedidoDeRemocao(uid)
        && !('excluido_em' in resource.data)
        && (recorrenciaAtivaValida(request.resource.data) || recorrenciaTombstoneValida(request.resource.data));
      allow delete: if false;
    }
  }
}
