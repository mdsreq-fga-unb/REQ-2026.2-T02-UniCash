
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function dono(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function dataValida(data) {
      return data is string
        && data.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function descricaoValida(d) {
      return !('descricao' in d)
        || d.descricao == null
        || (d.descricao is string && d.descricao.size() <= 255);
    }

    function valorValido(d) {
      return d.valor_centavos is int
        && d.valor_centavos > 0
        && d.valor_centavos <= 99999999999;
    }

    function receitaValida(d) {
      return d.keys().hasOnly([
          'valor_centavos', 'data', 'titulo', 'descricao',
          'recorrencia_id', 'criado_em', 'atualizado_em'
        ])
        && d.keys().hasAll([
          'valor_centavos', 'data', 'titulo',
          'criado_em', 'atualizado_em'
        ])
        && valorValido(d)
        && dataValida(d.data)
        && d.titulo is string
        && d.titulo.size() >= 1
        && d.titulo.size() <= 80
        && descricaoValida(d)
        && (!('recorrencia_id' in d)
          || d.recorrencia_id == null
          || d.recorrencia_id is string);
    }

    function despesaValida(d) {
      return d.keys().hasOnly([
          'valor_centavos', 'data', 'titulo', 'descricao',
          'categoria_id', 'fixa_ou_variavel', 'essencial',
          'recorrencia_id', 'criado_em', 'atualizado_em'
        ])
        && d.keys().hasAll([
          'valor_centavos', 'data', 'titulo',
          'criado_em', 'atualizado_em'
        ])
        && valorValido(d)
        && dataValida(d.data)
        && d.titulo is string
        && d.titulo.size() >= 1
        && d.titulo.size() <= 80
        && descricaoValida(d)
        && (!('categoria_id' in d)
          || d.categoria_id == null
          || d.categoria_id is string)
        && (!('fixa_ou_variavel' in d)
          || d.fixa_ou_variavel == null
          || d.fixa_ou_variavel in ['fixa', 'variavel'])
        && (!('essencial' in d)
          || d.essencial == null
          || d.essencial in [0, 1])
        && (!('recorrencia_id' in d)
          || d.recorrencia_id == null
          || d.recorrencia_id is string);
    }

    function recorrenciaValida(d) {
      return d.keys().hasOnly([
          'tipo', 'intervalo', 'unidade', 'inicio', 'termino',
          'ativa', 'valor_centavos', 'titulo', 'descricao',
          'categoria_id', 'fixa_ou_variavel', 'essencial',
          'atualizado_em'
        ])
        && d.keys().hasAll([
          'tipo', 'intervalo', 'unidade', 'inicio',
          'ativa', 'valor_centavos', 'titulo', 'atualizado_em'
        ])
        && d.tipo in ['receita', 'despesa']
        && d.intervalo is int
        && d.intervalo > 0
        && d.unidade in ['dia', 'mes', 'ano']
        && dataValida(d.inicio)
        && d.ativa is bool
        && valorValido(d)
        && d.titulo is string
        && d.titulo.size() >= 1
        && d.titulo.size() <= 80
        && descricaoValida(d)
        && (!('termino' in d)
          || (dataValida(d.termino) && d.termino >= d.inicio))
        && (!('categoria_id' in d)
          || d.categoria_id == null
          || d.categoria_id is string)
        && (!('fixa_ou_variavel' in d)
          || d.fixa_ou_variavel == null
          || d.fixa_ou_variavel in ['fixa', 'variavel'])
        && (!('essencial' in d)
          || d.essencial == null
          || d.essencial in [0, 1]);
    }

    match /usuarios/{uid}/receitas/{id} {
      allow read, delete: if dono(uid);
      allow create, update: if dono(uid)
        && receitaValida(request.resource.data);
    }

    match /usuarios/{uid}/despesas/{id} {
      allow read, delete: if dono(uid);
      allow create, update: if dono(uid)
        && despesaValida(request.resource.data);
    }

    match /usuarios/{uid}/recorrencias/{id} {
      allow read, delete: if dono(uid);
      allow create, update: if dono(uid)
        && recorrenciaValida(request.resource.data);
    }
  }
}
